<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_detection_client</name>
  <version>0.0.1</version>
  <description>ROS2 detector client node for YOLO object detection with RealSense depth fusion</description>
  
  <maintainer email="aaron.stark@example.com">Aaron Stark</maintainer>
  <license>MIT</license>

  <url type="website">https://github.com/astark146/crv_fieldrobotevent</url>
  <url type="repository">https://github.com/astark146/crv_fieldrobotevent</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2_detection_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>vision_opencv</exec_depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
