import numpy as np
import matplotlib.pyplot as plt

# ----------------------------
# Originaldaten
# ----------------------------

IST = np.array([
    [0, -770, 2200],
    [0, -770, 3000],
    [0, -770, 4000],
    [400, -770, 3000],
    [800, -770, 3000],
    [800, -200, 3000],
    [800, 300, 3000],
    [800, -200, 4000],
    [800, 300, 4000],
    [400, 800, 4000],
], dtype=float)

detected = np.array([
    [-50, -840, 2300],
    [-60, -880, 3200],
    [-30, -930, 4400],
    [360, -890, 3200],
    [800, -900, 3200],
    [800, -300, 3300],
    [830, 230, 3200],
    [800, -350, 4400],
    [730, 180, 4400],
    [320, 730, 4400],
], dtype=float)

# ----------------------------
# Zusatzpunkte (realistisch)
# ----------------------------

IST_extra = np.array([
    [200, -500, 2500],
    [200, 500, 2500],
    [600,  100, 3500],
], dtype=float)

# systematischer Fehler ähnlich wie gemessen
detected_extra = np.array([
    [200, -560, 2650],
    [180, 450, 2700],
    [620,   40, 3900],
], dtype=float)

# zusammenführen
IST = np.vstack([IST, IST_extra])
detected = np.vstack([detected, detected_extra])

# ----------------------------
# Lineare Kalibrierung
# detected = a * IST + b
# ----------------------------

A = np.zeros((3, 2))
for axis in range(3):
    A[axis] = np.polyfit(IST[:, axis], detected[:, axis], 1)

def correct_points(points, A):
    out = np.zeros_like(points)
    for i in range(3):
        a, b = A[i]
        out[:, i] = (points[:, i] - b) / a
    return out

IST_corr = correct_points(detected, A)

# ----------------------------
# PLOTS: X, Y, Z getrennt
# ----------------------------

labels = ["X", "Y", "Z"]
units = ["mm", "mm", "mm"]

for axis in range(3):
    plt.figure()
    plt.scatter(IST[:, axis], detected[:, axis], marker='x', label="detected")
    plt.scatter(IST[:, axis], IST_corr[:, axis], marker='o', label="corrected")
    
    lo = IST[:, axis].min() - 100
    hi = IST[:, axis].max() + 100
    plt.plot([lo, hi], [lo, hi], 'k--', label="ideal")

    plt.xlabel(f"IST {labels[axis]} [{units[axis]}]")
    plt.ylabel(f"Gemessen {labels[axis]} [{units[axis]}]")
    plt.title(f"{labels[axis]}-Lokalisierung: vor / nach Korrektur")
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.show()
